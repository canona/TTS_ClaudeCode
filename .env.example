# All variables are optional – the app runs out-of-the-box without any of them.
# Before opening the server to partners, set INTERNAL_BASIC_AUTH (see below).
# No API key is needed: Microsoft Edge TTS is free.

# Port the Next.js standalone server listens on (Railway/Coolify inject this automatically)
PORT=3102

# Number of text chunks synthesized in parallel per request (1-8)
TTS_CONCURRENCY=3
# Tổng số websocket Edge mở cùng lúc trên toàn server (nhiều request đồng thời dùng chung)
TTS_GLOBAL_CONCURRENCY=4

# Safety cap on input size in characters (default: 2,000,000 ≈ a long novel)
TTS_MAX_TEXT_LENGTH=2000000

# Max UTF-8 bytes (after XML escaping) per chunk sent to Edge TTS (Edge hard limit ≈ 4096)
TTS_MAX_CHUNK_BYTES=3000

# Size of the very first chunk – kept small so playback starts almost instantly.
# Each following chunk doubles in size up to TTS_MAX_CHUNK_BYTES.
TTS_FIRST_CHUNK_BYTES=200

# Server-side chunk cache: in-memory LRU budget and on-disk persistence
CACHE_MEMORY_MB=128
CACHE_DIR=./.tts-cache
CACHE_DISK_MAX_MB=2048

# Chromium version used to build the Sec-MS-GEC token headers.
# Bump this if Microsoft starts rejecting requests (HTTP 403) in the future.
EDGE_CHROMIUM_VERSION=143.0.3650.75

# Idle timeout per Edge websocket (ms without receiving any data)
TTS_CHUNK_TIMEOUT_MS=20000

# ---------------------------------------------------------------------------
# VieNeu-TTS (default offline Vietnamese engine) – https://github.com/pnnbao97/VieNeu-TTS
# The app starts its server by itself (uv run python -m apps.openai_speech).
# ---------------------------------------------------------------------------
# Base URL of the VieNeu server (inside Docker use http://host.docker.internal:8000)
VIENEU_URL=http://127.0.0.1:8000
# 0 = never launch VieNeu ourselves (only use one that is already running)
VIENEU_AUTOSTART=1
# Folder of the VieNeu-TTS checkout with `uv sync` done (default: ../VieNeu-TTS)
VIENEU_DIR=../VieNeu-TTS
# uv executable, if it is not on PATH
VIENEU_UV=uv
# Where cloned regional voices (recordings + index.json) are stored
VOICES_DIR=./.voices
# Passed through to VieNeu: fp32 (default) | int8 (faster on CPUs with VNNI)
# VIENEU_PRECISION=int8
# Only if the VieNeu server was started with VIENEU_API_KEY
VIENEU_API_KEY=
# Model id sent in requests; also part of the cache key
VIENEU_MODEL=vieneu-v3-turbo
# Max parallel requests per text; capped by the server's max_streams (CPU fp32: 1)
VIENEU_CONCURRENCY=4
# Chunk size for VieNeu (smaller = more accurate estimated captions)
VIENEU_MAX_CHUNK_BYTES=600
# No audio this long after sending (ms) → VieNeu is considered hung: it is restarted and the chunk retried
VIENEU_FIRST_BYTE_TIMEOUT_MS=60000
# Same for a gap in the middle of a stream (ms)
VIENEU_TIMEOUT_MS=30000
# VieNeu output + restart/timeout events, for diagnosing problems ('' disables)
VIENEU_LOG_FILE=./.vieneu.log

# ---------------------------------------------------------------------------
# Partner API (/api/v1) – see docs/API.md. Clients: node scripts/clients.mjs
# ---------------------------------------------------------------------------
# Registered clients (only SHA-256 hashes of their keys are stored)
CLIENTS_FILE=./.clients/clients.json
# Monthly usage records, one NDJSON line per request (billing)
USAGE_DIR=./.usage
# Synthesis requests running at once across all clients (CPU-only VieNeu: 1-2)
V1_MAX_CONCURRENT=2
# user:password protecting the internal web UI and its routes (empty = open).
# /api/v1/* (API keys) and /api/health are never behind it.
INTERNAL_BASIC_AUTH=
# user:password of the /admin page (create, rotate, disable partner API keys in the browser).
# Use a different, strong password. Empty = /admin does not exist (404).
ADMIN_BASIC_AUTH=
